<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@color/black"
    tools:context=".AccountFragment">

    <TextView
        android:id="@+id/titleAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_16dp"
        android:fontFamily="@font/roboto"
        android:text="@string/account_txt"
        android:textColor="@color/white"
        android:textSize="@dimen/txt_22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/viewBackground"
        android:layout_width="0dp"
        android:layout_height="128dp"
        android:layout_margin="@dimen/margin_16dp"
        android:background="@drawable/background_view_account"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleAccount">

        <TextView
            android:id="@+id/support"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginVertical="@dimen/size_10dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:text="@string/send_support"
            android:textColor="@color/white"
            android:textSize="@dimen/txt_14sp"
            app:drawableEndCompat="@drawable/icon_arrow" />

        <View
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginVertical="@dimen/size_10dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:text="@string/settings"
            android:textColor="@color/white"
            android:textSize="@dimen/txt_14sp"
            app:drawableEndCompat="@drawable/icon_arrow" />

        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:background="@color/gray" />

        <TextView
            android:id="@+id/signOut"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginVertical="@dimen/size_10dp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:text="@string/sign_out"
            android:textColor="@color/white"
            android:textSize="@dimen/txt_14sp"
            app:drawableEndCompat="@drawable/icon_arrow" />

    </LinearLayout>

    <TextView
        android:id="@+id/titleMyCourses"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_16dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto"
        android:text="@string/your_courses_txt"
        android:textColor="@color/white"
        android:textSize="@dimen/txt_22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewBackground" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/RvMyCoursesList"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_16dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titleMyCourses" />

</androidx.constraintlayout.widget.ConstraintLayout>